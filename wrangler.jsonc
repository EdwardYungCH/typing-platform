{
  // Cloudflare Workers 設定：只發佈 npm run build 產生的 dist/ 資料夾。
  // 名稱要與 Cloudflare 上的項目名稱一致。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sphrc-typing-platform",
  "compatibility_date": "2026-10-06",
  // 開啟 xxx.workers.dev 網址；日後加學校網域時仍可保留
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  }
}
